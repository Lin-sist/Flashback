<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flashback.mapper.AgentMemorySourceMapper">

    <resultMap id="AgentMemorySourceResultMap" type="com.flashback.domain.AgentMemorySource">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="assistantMessageId" column="assistant_message_id"/>
        <result property="sourceRecordId" column="source_record_id"/>
        <result property="sourceKind" column="source_kind" javaType="com.flashback.domain.AgentMemorySourceKind"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.flashback.domain.AgentMemorySource" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO agent_memory_source (
            user_id,
            session_id,
            assistant_message_id,
            source_record_id,
            source_kind,
            created_at
        ) VALUES (
            #{userId},
            #{sessionId},
            #{assistantMessageId},
            #{sourceRecordId},
            #{sourceKind},
            #{createdAt}
        )
    </insert>

    <select id="selectBySessionIdAndUserId" resultMap="AgentMemorySourceResultMap">
        SELECT
            id,
            user_id,
            session_id,
            assistant_message_id,
            source_record_id,
            source_kind,
            created_at
        FROM agent_memory_source
        WHERE session_id = #{sessionId}
          AND user_id = #{userId}
        ORDER BY id ASC
    </select>

</mapper>
