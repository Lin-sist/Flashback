# 本地开发 secret 模板（C2 起启用）
#
# 用法：
#   1. 复制本文件为 secrets.local.env（同目录）
#   2. 填入你自己的凭证取值
#   3. secrets.local.env 已被 .gitignore 忽略，禁止提交
#
# 约定：
#   - 格式为 KEY=value，不要加引号
#   - 允许留空（例如使用长期 AK/SK 时 S3_SESSION_TOKEN 为空）
#   - 但键名必须存在，否则启动脚本会快速失败而非静默用空值继续
#
# 为什么不再写在 start-dev-wechat.local.ps1 里：
#   该脚本混杂了启动逻辑与明文凭证，一旦被查看/粘贴/截图就会连带泄露。
#   拆分后凭证集中在单一文件，便于轮换，也便于将来换成密钥管理服务。

# AI provider（DeepSeek / OpenAI-compatible）
AI_API_KEY=

# 对象存储（S3-compatible，例如阿里云 OSS）
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 使用长期 AK/SK 时留空；仅在使用 STS 临时凭证时填写
S3_SESSION_TOKEN=

# 微信小程序 appsecret
WECHAT_MINI_PROGRAM_SECRET=

# 七牛（当前未启用，保留占位）
# QINIU_ACCESS_KEY=
# QINIU_SECRET_KEY=
