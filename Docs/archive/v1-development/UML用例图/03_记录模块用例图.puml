@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle stickman
skinparam defaultFontName Microsoft YaHei

title 记录模块用例图

actor "普通用户" as User
actor "对象存储" as OSS

rectangle "记录模块" {
  usecase "创建草稿" as UC1
  usecase "编辑草稿" as UC2
  usecase "删除草稿" as UC3
  usecase "添加位置" as UC4
  usecase "添加图片/语音附件" as UC5
  usecase "选择封面" as UC6
  usecase "封存记录" as UC7
  usecase "查看记录详情" as UC8
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
OSS --> UC5
UC5 ..> UC6 : <<extend>>
@enduml
