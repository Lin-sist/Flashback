@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle stickman
skinparam defaultFontName Microsoft YaHei

title 时间回看模块用例图

actor "普通用户" as User

rectangle "时间回看模块" {
  usecase "查看原记录" as UC1
  usecase "查看位置" as UC2
  usecase "预览图片 / 播放语音" as UC3
  usecase "查看你当时以为" as UC4
  usecase "填写后来其实" as UC5
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
@enduml
