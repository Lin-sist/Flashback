@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle stickman
skinparam defaultFontName Microsoft YaHei

title 标签与时光轴模块用例图

actor "普通用户" as User

rectangle "标签与时光轴模块" {
  usecase "查询标签列表" as UC1
  usecase "记录绑定标签" as UC2
  usecase "按单标签筛选" as UC3
  usecase "按年月日筛选" as UC4
  usecase "分页加载时光轴" as UC5
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
@enduml
